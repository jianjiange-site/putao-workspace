# =============================================================================
# Local environment template for putao-workspace.
#
# USAGE:
#   1. Copy this file to .env.local (same directory) and fill in real values.
#   2. .env.local is gitignored (.gitignore line 44: `.env.*`).
#   3. Never commit .env.local. Never paste real secrets into this template.
#
# HOW SERVICES PICK IT UP:
#   - Spring Boot does NOT auto-load .env files.
#   - IntelliJ: install the ".env files support" plugin
#       (Settings -> Plugins -> Marketplace -> ".env files support").
#     Then open Run/Debug Configuration -> "EnvFile" tab -> enable .env.local.
#   - VS Code: extension "dotenv" plus a launch.json envFile entry.
#   - CLI alternative: `export $(grep -v '^#' .env.local | xargs)` before mvn.
# =============================================================================

# --- Nacos --------------------------------------------------------------------
# Shared dev Nacos at VPS 38.76.188.242
NACOS_SERVER_ADDR=38.76.188.242:8848
NACOS_NAMESPACE=putao-dating-dev
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-real-nacos-password

# --- Active profile -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (shared dev at VPS 38) ----------------------------------------
# Per-service schema lives in url path: dating_dev_<yourname>
PG_PASSWORD=replace-with-real-pg-password

# --- Redis (shared dev at VPS 38) ---------------------------------------------
REDIS_HOST=38.76.188.242
REDIS_PORT=6380
REDIS_PASSWORD=replace-with-real-redis-password
REDIS_DATABASE=1

# --- Per-service HTTP/gRPC ports (uncomment/override if you need to remap) ----
# EXAMPLE_SERVICE_PORT=18080
# EXAMPLE_GRPC_PORT=19090
# USER_SERVICE_PORT=18081
# USER_GRPC_PORT=19091
# MATCH_SERVICE_PORT=18082
# MATCH_GRPC_PORT=19092
# IM_SERVICE_PORT=18083
# IM_GRPC_PORT=19093
# POST_SERVICE_PORT=18084
# POST_GRPC_PORT=19094
# PAYMENT_SERVICE_PORT=18085
# PAYMENT_GRPC_PORT=19095
# GATEWAY_PORT=8080
# GATEWAY_GRPC_PORT=19080
